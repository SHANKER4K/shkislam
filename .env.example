DATABASE_URL="postgresql://postgres:password@localhost:5432/dbname"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Backend (FastAPI): "disable" for a local Postgres without TLS; default is "require"
DATABASE_SSLMODE="require"

# --- FastAPI backend (Next.js server side) ---
# Server-only, never NEXT_PUBLIC_*. API_URL/USER_SHARED_SECRET/BOT_SHARED_SECRET
# must be byte-identical to the same vars in the backend's .env.
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"
API_URL="http://backend:8000"
USER_SHARED_SECRET="generate-a-long-random-string"
BOT_SHARED_SECRET="generate-a-long-random-string"

# --- Bootstrapping auth ---
BETTER_AUTH_URL="https://yourdomain.com"
# Per-environment and unique; BETTER_AUTH_SECRET signs sessions. (The backend's
# ENCRYPTION_MASTER_KEY must be unique per environment too, and rotating it makes
# every stored provider key unreadable.)
BETTER_AUTH_SECRET="generate-a-long-random-string"
